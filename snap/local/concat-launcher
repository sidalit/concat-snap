#!/bin/sh
set -eu

export XDG_CONFIG_HOME="$SNAP_USER_DATA/.config"
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
export ALSA_CONFIG_PATH="$SNAP/etc/alsa/alsa.conf"

for plugin in "$SNAP"/usr/lib/*-linux-gnu/alsa-lib/libasound_module_pcm_pulse.so; do
    if [ -f "$plugin" ]; then
        export ALSA_PLUGIN_DIR="${plugin%/*}"
        break
    fi
done

mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"
exec "$SNAP/opt/concat/concat" "$@"
