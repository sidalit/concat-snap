diff --git a/src/crates/concat-server/src/lib.rs b/src/crates/concat-server/src/lib.rs
index 130fed1..1859a4e 100644
--- a/src/crates/concat-server/src/lib.rs
+++ b/src/crates/concat-server/src/lib.rs
@@ -129,11 +129,24 @@ pub struct Config {
 /// Where the API writes when told nothing else: the user's home folder,
 /// or nowhere when the platform has none to name.
 pub fn home_root() -> Vec<PathBuf> {
-    std::env::var_os("HOME")
+    let home = std::env::var_os("HOME")
         .or_else(|| std::env::var_os("USERPROFILE"))
         .filter(|home| !home.is_empty())
-        .map(|home| vec![PathBuf::from(home)])
-        .unwrap_or_default()
+        .map(PathBuf::from);
+    if cfg!(target_os = "linux") && std::env::var_os("SNAP").is_some() {
+        // Snap redirects HOME; keep public projects and private app data writable.
+        ["SNAP_REAL_HOME", "SNAP_USER_DATA", "SNAP_USER_COMMON"]
+            .into_iter()
+            .filter_map(std::env::var_os)
+            .map(PathBuf::from)
+            .filter(|path| path.is_absolute())
+            .filter_map(|path| path.canonicalize().ok())
+            .filter(|path| path.is_dir() && path.parent().is_some())
+            .chain(home)
+            .collect()
+    } else {
+        home.into_iter().collect()
+    }
 }
 
